{
  "name": "mini-blog-api",
  "version": "2.0.0",
  "description": "API REST de Mini Blog (Express + PostgreSQL): autores, artículos, comentarios",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:railway": "npm run db:init && node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node scripts/init-db.js",
    "db:seed": "node scripts/init-db.js --seed",
    "test": "node --test tests/api.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "pg": "^8.13.0"
  },
  "engines": {
    "node": ">=18"
  }
}
