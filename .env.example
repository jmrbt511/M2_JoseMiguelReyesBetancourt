# Puerto HTTP (Railway lo proporciona automáticamente)
PORT=3000

# Conexión a PostgreSQL (aplicación)
DATABASE_URL=postgresql://postgres:motdepasse@localhost:5432/mini_blog
# Poner true si la base de datos exige SSL (p. ej. URL pública de un proveedor)
DATABASE_SSL=false
# Tamaño máximo del pool de conexiones
PG_POOL_MAX=10

# Base de datos EXCLUSIVA para tests (sus tablas se eliminan y recrean en cada `npm test`)
TEST_DATABASE_URL=postgresql://postgres:motdepasse@localhost:5432/mini_blog_test
